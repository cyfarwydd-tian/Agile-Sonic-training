# Optional override for file-backed credentials. Copy this file outside the
# repository, set every referenced host path, and combine it with compose.yaml:
#
#   SONIC_SOURCE=/srv/agile-sonic/source \
#   DATASETS_DIR=/srv/agile-sonic/datasets \
#   docker compose -f compose.yaml -f /secure/compose.secrets.yaml up -d
#
# Remove any unused secret declaration/mount; SSH also has a matching
# environment entry. Never place credential contents here or in `.env`.

services:
  sonic-training:
    ports:
      - "${SSH_PORT:-2222}:22"
    environment:
      SSH_AUTHORIZED_KEYS_FILE: /run/secrets/ssh_authorized_keys
    secrets:
      - source: ssh_authorized_keys
        target: ssh_authorized_keys
      - source: aws_credentials
        target: aws_credentials
      - source: aws_config
        target: aws_config
      - source: alicloud_config
        target: alicloud_config

secrets:
  ssh_authorized_keys:
    file: ${SSH_AUTHORIZED_KEYS_FILE:?set SSH_AUTHORIZED_KEYS_FILE to a public-key file}
  aws_credentials:
    file: ${AWS_SHARED_CREDENTIALS_FILE:?set AWS_SHARED_CREDENTIALS_FILE}
  aws_config:
    file: ${AWS_CONFIG_FILE:?set AWS_CONFIG_FILE}
  alicloud_config:
    file: ${ALIBABA_CLOUD_CONFIG_FILE:?set ALIBABA_CLOUD_CONFIG_FILE}
