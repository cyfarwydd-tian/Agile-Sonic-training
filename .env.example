# Non-sensitive Docker Compose settings only. Never place credentials here.
IMAGE=ghcr.io/cyfarwydd-tian/agile-sonic-training:latest
BUILD_TARGET=full
CONTAINER_NAME=agile-sonic-training
CONTAINER_USER=fangzhengtian
HOST_UID=1000
HOST_GID=1000

SONIC_SOURCE=/srv/agile-sonic/source
DATASETS_DIR=/srv/agile-sonic/datasets
RUNS_DIR=/srv/agile-sonic/runs
CACHE_DIR=/srv/agile-sonic/cache
DATASETS_READ_ONLY=true

NVIDIA_VISIBLE_DEVICES=all
GPU_REQUEST=all
GPU_COUNT=
SONIC_ENV=agile-sonic
WANDB_MODE=offline
# Used only when compose.secrets.yaml.example enables key-only SSH.
SSH_PORT=2222
FIX_MOUNT_OWNERSHIP=0
